#!/usr/bin/env -S bun --no-env-file --config=/dev/null
// Gemini outside-review runner (outside_provider gemini). Prompts arrive on
// stdin, never argv. codex_reviews gates the send (lib/outside-consent.ts);
// --user-invoked marks a review the user asked for by name and runs regardless.
// `--probe` and `setup` send nothing and skip the gate.
import { geminiMain } from '../lib/gemini-review';
import { outsideConsent } from '../lib/outside-consent';

const argv = process.argv.slice(2);
if (argv[0] !== '--probe' && argv[0] !== 'setup') {
  const consent = outsideConsent({ userInvoked: argv.includes('--user-invoked') });
  if (!consent.allowed) {
    process.stderr.write(consent.lines.join('\n') + '\n');
    process.stdout.write(JSON.stringify({ status: 'not_run', reason: 'consent_missing', stderr: consent.lines.join('\n') }) + '\n');
    process.exit(3);
  }
}
process.exit(await geminiMain(argv.filter(a => a !== '--user-invoked')));
